{
  "expo": {
    "name": "Pulso",
    "slug": "pulso",
    "scheme": "pulso",
    "owner": "code-for-all",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pulso.ec"
    },
    "android": {
      "package": "com.pulso.ec",
      "googleServicesFile": "./google-services.json",
      "versionCode": 4,
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#F5C518"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Pulso necesita acceso a tus fotos para cambiar tu foto de perfil.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "@react-native-community/datetimepicker",
      "./plugins/withReleaseSigning",
      "expo-image",
      ["@sentry/react-native", { "url": "https://sentry.io/", "organization": "code-for-all", "project": "pulso-tracking" }]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a5cb2fb9-b56d-495a-a3d2-fe37846beba6"
      }
    }
  }
}
