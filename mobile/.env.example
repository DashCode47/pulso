EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_KEY=

# Sentry (DSN is public; auth token is not — keep it out of git)
EXPO_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Mixpanel (project token is public, like the Supabase key)
EXPO_PUBLIC_MIXPANEL_TOKEN=
# Only for EU data residency projects:
# EXPO_PUBLIC_MIXPANEL_SERVER_URL=https://api-eu.mixpanel.com
# Set to 1 to send events from dev builds (to check the setup)
# EXPO_PUBLIC_MIXPANEL_IN_DEV=1
